# 复制为 .env.prod 并填写真实值（.env.prod 已被 .gitignore 排除，勿提交）。
# 用法：docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# PostgreSQL 口令（必填）
HOSPITAL_DB_PASSWORD=

# JWT 签名密钥，至少 32 字节（必填）。生成示例：
#   openssl rand -base64 48
HOSPITAL_JWT_SECRET=

# 浏览器访问后端 API 的对外地址（必填，构建期内联进前端）
# 例：https://api.example.com 或 http://服务器IP:8080
NEXT_PUBLIC_API_BASE_URL=

# AI 功能（可选）。提供火山方舟 API key 并置 true 才会装配 AI 模块
HOSPITAL_AI_ENABLED=false
HOSPITAL_AI_API_KEY=

# Qdrant 鉴权（可选，生产建议开启）
HOSPITAL_QDRANT_API_KEY=
